# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Local dev: `npm run db:start` runs Postgres on 127.0.0.1:54329 (user/password: tendril)
DATABASE_URL="postgresql://tendril:tendril@127.0.0.1:54329/tendril"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Needed when running behind a proxy or with `next start` locally
AUTH_TRUST_HOST="true"
# Optional Google sign-in (the button is hidden when these are empty)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- App ---
# Public base URL. Used in canonical links, OG tags and Stripe redirects. Read at build time.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Protects /api/cron/rollup and /api/internal/revalidate (send as: Authorization: Bearer <value>)
CRON_SECRET=""

# --- Email (password reset and verification) ---
# Production: Resend API key and a verified sender address.
RESEND_API_KEY=""
MAIL_FROM="Tendril <no-reply@yourdomain.com>"
# Optional override: resend | file | disabled. Default: resend if RESEND_API_KEY is set,
# else "file" in development (writes to .mail-outbox.jsonl) and "disabled" in production.
MAIL_TRANSPORT=""

# Local end-to-end testing only (every test request comes from one IP). Never set in production.
DISABLE_RATE_LIMITS=""

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."
# Safety switch: live keys (sk_live_) are refused unless this is "true"
ALLOW_LIVE_STRIPE="false"
