# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Local dev: `npm run db:start` runs Postgres on 127.0.0.1:54329 (user/password: tendril)
DATABASE_URL="postgresql://tendril:tendril@127.0.0.1:54329/tendril"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Needed when running behind a proxy or with `next start` locally
AUTH_TRUST_HOST="true"
# Optional Google sign-in (the button is hidden when these are empty)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- App ---
# Public base URL. Used in canonical links, OG tags and Stripe redirects. Read at build time.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Protects /api/cron/rollup and /api/internal/revalidate (send as: Authorization: Bearer <value>)
CRON_SECRET=""

# --- Email (password reset and verification) ---
# Free option: Brevo (300 emails/day, no domain needed). Create an API key and verify the
# MAIL_FROM address in Brevo (Senders). Or Resend, which needs your own verified domain.
BREVO_API_KEY=""
RESEND_API_KEY=""
MAIL_FROM="ViewLink <no-reply@yourdomain.com>"
# Optional override: brevo | resend | file | disabled. Default: brevo/resend if a key is set,
# else "file" in development (writes to .mail-outbox.jsonl) and "disabled" in production.
MAIL_TRANSPORT=""

# Local end-to-end testing only (every test request comes from one IP). Never set in production.
DISABLE_RATE_LIMITS=""

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."
# Safety switch: live keys (sk_live_) are refused unless this is "true"
ALLOW_LIVE_STRIPE="false"

# --- Crypto payments (NOWPayments): prepaid Pro, a month or a year per payment ---
# Store settings → API keys, and → Instant payment notifications (IPN secret).
# Set the IPN callback URL there to https://<your app>/api/crypto/ipn
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
# Optional: https://api-sandbox.nowpayments.io/v1 to test with the sandbox
NOWPAYMENTS_API_URL=""

# --- Custom domains (Vercel) ---
# Vercel access token so ViewLink adds creators' domains to the Vercel project automatically.
# VERCEL_TEAM_ID is the team's id (Settings → General) when the project belongs to a team.
VERCEL_API_TOKEN=""
VERCEL_TEAM_ID=""

# --- Custom domains (Netlify) ---
# Personal access token so ViewLink adds creators' domains to the Netlify site automatically.
NETLIFY_API_TOKEN=""
