generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth.js (Prisma adapter) ----------

model User {
  id               String                @id @default(cuid())
  email            String                @unique
  emailVerified    DateTime?
  name             String?
  image            String?
  passwordHash     String?
  sessionVersion   Int                   @default(0)
  stripeCustomerId String?               @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  accounts         Account[]
  sessions         Session[]
  pages            Page[]
  subscription     Subscription?
  authTokens       AuthToken[]
  smartLinks       SmartLink[]
  domains          Domain[]
  // Affiliate program ("Grow with ViewLink"): this user's code and payout email, and who referred them
  affiliateCode    String?               @unique
  payoutEmail      String?
  referredById     String?
  referredBy       User?                 @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals        User[]                @relation("Referrals")
  referredAt       DateTime?
  affiliateClicks  AffiliateClick[]
  commissions      AffiliateCommission[]
  payoutRequests   PayoutRequest[]
  cryptoPayments   CryptoPayment[]

  @@index([referredById])
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

// Single-use tokens for password reset and email verification. Only a SHA-256
// hash is stored; the raw token exists only in the emailed link.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Pages & blocks ----------

model Page {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  username        String    @unique
  displayName     String    @default("")
  bio             String    @default("")
  avatarUrl       String?
  themeKey        String    @default("paper")
  themeOverrides  Json?
  seoTitle        String?
  seoDescription  String?
  published       Boolean   @default(true)
  showBadge       Boolean   @default(true)
  // Warning template for content-warning links on the bio page (null = match the page theme)
  warningTemplate String?
  // Inside Instagram/TikTok/etc., link taps open in the phone's default browser (deep link)
  openInBrowser   Boolean   @default(true)
  // Page template: classic | simple-stack | modern-card | spotlight | pro-card | personal-card
  layout          String    @default("classic")
  // Cover/background photo used by the photo templates
  heroUrl         String?
  // Short line under the name, e.g. "Painter" or "20 · Florida"
  tagline         String    @default("")
  // Verified badge: Pro creators switch it on themselves (showVerified); the site owner can also
  // grant it to any page (verifiedAt), which keeps it whatever the plan.
  verifiedAt      DateTime?
  showVerified    Boolean   @default(false)
  // The @username shown on the page: a custom one (null = the page's username), or hidden
  handle          String?
  showHandle      Boolean   @default(true)
  // Set by the site owner (scripts/showcase-page.mjs): the public preview of its template in the gallery
  showcase        Boolean   @default(false)
  // The page's link: a connected custom domain (null = the ViewLink domain), at its root or at /<username>
  domainId        String?
  domain          Domain?   @relation(fields: [domainId], references: [id], onDelete: SetNull)
  atRoot          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  blocks          Block[]

  @@index([userId, createdAt])
  @@index([domainId])
}

enum BlockType {
  LINK
  HEADER
  TEXT
  SOCIAL_ROW
  // YouTube or Spotify player (url = the video/track page)
  EMBED
  // Countdown timer (data.until = ISO date)
  COUNTDOWN
}

model Block {
  id                 String       @id @default(cuid())
  pageId             String
  page               Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type               BlockType
  position           Int
  enabled            Boolean      @default(true)
  title              String       @default("")
  url                String?
  data               Json         @default("{}")
  contentWarning     Boolean      @default(false)
  contentWarningText String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  clicks             ClickEvent[]

  @@index([pageId, position])
}

// ---------- Analytics ----------

model PageView {
  id           BigInt   @id @default(autoincrement())
  pageId       String
  ts           DateTime @default(now())
  visitorHash  String
  referrerHost String?
  source       String
  country      String?
  device       String
  os           String?
  browser      String?
  isBot        Boolean  @default(false)

  @@index([pageId, ts])
}

model ClickEvent {
  id               BigInt   @id @default(autoincrement())
  pageId           String
  blockId          String
  block            Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  ts               DateTime @default(now())
  visitorHash      String
  country          String?
  device           String
  os               String?
  browser          String?
  warningConfirmed Boolean  @default(false)
  isBot            Boolean  @default(false)

  @@index([pageId, ts])
  @@index([blockId, ts])
}

model WarningView {
  id          BigInt   @id @default(autoincrement())
  pageId      String
  blockId     String
  ts          DateTime @default(now())
  visitorHash String

  @@index([blockId, ts])
}

model DailyStat {
  pageId     String
  day        DateTime @db.Date
  views      Int      @default(0)
  uniques    Int      @default(0)
  clicks     Int      @default(0)
  byReferrer Json     @default("{}")
  byCountry  Json     @default("{}")
  byDevice   Json     @default("{}")
  byBlock    Json     @default("{}")

  @@id([pageId, day])
}

model DailySalt {
  day  DateTime @id @db.Date
  salt String
}

// ---------- Billing ----------

enum Plan {
  FREE
  PRO
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan      @default(FREE)
  status               String
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  updatedAt            DateTime  @updatedAt
}

model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}

// ---------- Smart links (short links with an optional 18+ warning page) ----------

model SmartLink {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String           @unique
  destinationUrl  String
  label           String           @default("")
  enabled         Boolean          @default(true)
  // Adult content warning: on by default for every new link
  adultWarning    Boolean          @default(true)
  warningTemplate String           @default("clear-blue")
  warningTitle    String?
  warningMessage  String?
  warningButton   String?
  showBadge       Boolean          @default(true)
  // Inside Instagram/TikTok/etc., show a page that opens the link in the default browser
  openInBrowser   Boolean          @default(true)
  // Custom domain the link is shared on (null = the ViewLink domain)
  domainId        String?
  domain          Domain?          @relation(fields: [domainId], references: [id], onDelete: SetNull)
  // Root: the link is the whole custom domain (example.com/) instead of example.com/<slug>
  atRoot          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  events          SmartLinkEvent[]

  @@index([userId, createdAt])
}

// kind: "view" (warning shown), "confirm" (visitor confirmed 18+), "redirect" (sent to destination), "leave"
model SmartLinkEvent {
  id          BigInt    @id @default(autoincrement())
  linkId      String
  link        SmartLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  kind        String
  ts          DateTime  @default(now())
  visitorHash String
  country     String?
  device      String
  os          String?
  browser     String?
  isBot       Boolean   @default(false)

  @@index([linkId, ts])
}

// Uploaded images (avatars, cover photos, link images), served by /media/<key>.
// Kept in Postgres so uploads work the same locally and on serverless hosts.
model Media {
  key         String   @id
  pageId      String
  contentType String
  bytes       Bytes
  createdAt   DateTime @default(now())

  @@index([pageId])
}

// A creator's own domain (e.g. links.example.com), pointed at ViewLink with a DNS record.
model Domain {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostname   String      @unique
  verifiedAt DateTime?
  createdAt  DateTime    @default(now())
  smartLinks SmartLink[]
  pages      Page[]

  @@index([userId])
}

// A template's public preview in the gallery: a frozen copy of a showcased page (its images are
// copied too, so later edits or deletes of that page don't change the preview). New pages made
// from the template start from this content. Set with scripts/showcase-page.mjs.
model TemplateShowcase {
  layout    String   @id
  data      Json
  updatedAt DateTime @default(now()) @updatedAt
}

// ---------- Affiliate program ----------

// A visit to someone's /join/<code> link.
model AffiliateClick {
  id          BigInt   @id @default(autoincrement())
  affiliateId String
  affiliate   User     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  ts          DateTime @default(now())
  visitorHash String

  @@index([affiliateId, ts])
}

// What an affiliate earns from one paid invoice of someone they referred.
model AffiliateCommission {
  id             String         @id @default(cuid())
  affiliateId    String
  affiliate      User           @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId String
  invoiceId      String         @unique
  paidCents      Int
  rate           Int
  amountCents    Int
  availableAt    DateTime
  payoutId       String?
  payout         PayoutRequest? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())

  @@index([affiliateId, createdAt])
  @@index([referredUserId])
}

// requested -> paid (by the site owner: scripts/mark-payout-paid.mjs)
model PayoutRequest {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents Int
  email       String
  status      String                @default("requested")
  createdAt   DateTime              @default(now())
  paidAt      DateTime?
  commissions AffiliateCommission[]

  @@index([userId, createdAt])
}

// A Pro payment in crypto through NOWPayments. Crypto can't renew by itself, so each payment
// adds a prepaid month or year (Subscription.status "prepaid" until currentPeriodEnd).
model CryptoPayment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "month" | "year"
  interval    String
  amountCents Int
  invoiceId   String?   @unique
  // NOWPayments payment_status: waiting, confirming, confirmed, sending, partially_paid, finished, failed, refunded, expired
  status      String    @default("waiting")
  payCurrency String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}
